{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "alios add severity 5",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/alios.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "add",
                "--event", "1",
                "--eventid", "10001",
                "--groups", "AVAIL, SG/S.AXR",
                "--triggerTime", "2026.06.30 12:00:00",
                "--eventRecoveryTime", "{EVENT.RECOVERY.DATE} {EVENT.RECOVERY.TIME}",
                "--trigName", "Test alert",
                "--message", "Test message",
                "--severity", "5",
                "-v"
            ]
        },
        {
            "name": "alios add severity 0-4",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/alios.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": ["add", "--event", "1", "--groups", "AVAIL, SG/S.AXR", "--triggerTime", "2026.06.30 12:00:00", "--eventRecoveryTime", "{EVENT.RECOVERY.DATE} {EVENT.RECOVERY.TIME}", "--trigName", "Test alert", "--message", "Test message", "--severity", "4", "-v"]
        },
        {
            "name": "alios select",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/alios.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": ["select", "--path", "$", "-v"]
        },
        {
            "name": "alerts_watcher",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/alerts_watcher.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": ["-v"]
        },
        {
            "name": "actor",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/actor.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": ["-v"]
        }
    ]
}
